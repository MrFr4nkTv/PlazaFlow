{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/",
        "destination": "/public/client/index.html"
      },
      {
        "source": "/menu",
        "destination": "/public/client/index.html"
      },
      {
        "source": "/carrito",
        "destination": "/public/client/cart.html"
      },
      {
        "source": "/checkout",
        "destination": "/public/client/checkout.html"
      },
      {
        "source": "/producto",
        "destination": "/public/client/item-detail.html"
      },
      {
        "source": "/tracking",
        "destination": "/public/client/tracking.html"
      },
      {
        "source": "/success",
        "destination": "/public/client/success.html"
      },
      {
        "source": "/login",
        "destination": "/public/admin/login.html"
      },
      {
        "source": "/cocina",
        "destination": "/public/admin/kds.html"
      },
      {
        "source": "/inventario",
        "destination": "/public/admin/stock.html"
      },
      {
        "source": "/historial",
        "destination": "/public/admin/history.html"
      },
      {
        "source": "/pedido",
        "destination": "/public/admin/admin-detail.html"
      }
    ],
    "redirects": [
      {
        "source": "/index.html",
        "destination": "/public/client/index.html",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
